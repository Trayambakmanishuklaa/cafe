generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  PRE_ORDER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  CASH_AT_COUNTER
  LOYALTY_POINTS
}

enum MembershipTier {
  BRONZE
  SILVER
  GOLD
  VIP
}

enum LoyaltyTxType {
  EARN
  REDEEM
  EXPIRE
  REFUND_REVERSAL
  MANUAL_ADJUSTMENT
}

enum RewardType {
  FREE_ITEM
  DISCOUNT_PERCENT
  DISCOUNT_FLAT
}

enum DiscountType {
  PERCENT
  FLAT
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  name         String
  phone        String?  @unique
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile              CustomerProfile?
  bookings             Booking[]
  orders               Order[]
  payments             Payment[]
  loyaltyAccount       LoyaltyAccount?
  rewardRedemptions    RewardRedemption[]
  customerAchievements CustomerAchievement[]
  customerChallenges   CustomerChallenge[]
  couponRedemptions    CouponRedemption[]
  feedbacks            Feedback[]
  auditLogs            AuditLog[]
  expenses             Expense[]
  dailySales           DailySales[]
}

model CustomerProfile {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @unique @db.ObjectId
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthday     DateTime?
  preferences  String?
  favoriteItem String?
  totalOrders  Int       @default(0)
  totalSpend   Float     @default(0.0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  products Product[]
}

model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId      String   @db.ObjectId
  category        Category @relation(fields: [categoryId], references: [id])
  name            String
  description     String
  price           Float
  imageUrl        String?
  isAvailable     Boolean  @default(true)
  stockCount      Int      @default(100)
  isVeg           Boolean  @default(true)
  prepTimeMinutes Int      @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customizations ProductCustomization[]
  orderItems     OrderItem[]
  comboItems     ComboItem[]
}

model ProductCustomization {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  productId     String   @db.ObjectId
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  optionsJson   String
  isMultiSelect Boolean  @default(false)
  isRequired    Boolean  @default(false)
}

model Combo {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  description   String
  originalPrice Float
  comboPrice    Float
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  items ComboItem[]
}

model ComboItem {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  comboId   String  @db.ObjectId
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
}

model CafeTable {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  tableNumber      Int         @unique
  name             String?
  capacity         Int         @default(4)
  description      String?
  zone             String      @default("MAIN_HALL")
  status           TableStatus @default(AVAILABLE)
  manualStatus     String      @default("FREE") // FREE, BOOKED, MAINTENANCE
  isActive         Boolean     @default(true)
  createdByStaffId String?     @db.ObjectId
  qrCode           String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime?   @updatedAt

  bookings     Booking[]
  bookingHolds BookingHold[]
  orders       Order[]
}

model Booking {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  bookingCode   String        @unique
  userId        String        @db.ObjectId
  user          User          @relation(fields: [userId], references: [id])
  tableId       String        @db.ObjectId
  table         CafeTable     @relation(fields: [tableId], references: [id])
  guestCount    Int
  bookingDate   DateTime
  startTime     String
  endTime       String
  status        BookingStatus @default(PENDING)
  bookingFee    Float         @default(0.0)
  depositAmount Float         @default(0.0)
  qrCode        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orders   Order[]
  payments Payment[]
}

model BookingHold {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  tableId     String    @db.ObjectId
  table       CafeTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId      String    @db.ObjectId
  bookingDate DateTime
  startTime   String
  endTime     String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model Order {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber   String        @unique
  userId        String        @db.ObjectId
  user          User          @relation(fields: [userId], references: [id])
  tableId       String?       @db.ObjectId
  table         CafeTable?    @relation(fields: [tableId], references: [id])
  bookingId     String?       @db.ObjectId
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  orderType     OrderType     @default(DINE_IN)
  status        OrderStatus   @default(PENDING)
  subtotal      Float
  discount      Float         @default(0.0)
  tax           Float         @default(0.0)
  totalAmount   Float
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items             OrderItem[]
  payments          Payment[]
  couponRedemptions CouponRedemption[]
  feedbacks         Feedback[]
}

model OrderItem {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId            String   @db.ObjectId
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String   @db.ObjectId
  product            Product  @relation(fields: [productId], references: [id])
  productName        String
  unitPrice          Float
  quantity           Int
  subtotal           Float
  customizationsJson String?
}

model Payment {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId        String?       @db.ObjectId
  order          Order?        @relation(fields: [orderId], references: [id])
  bookingId      String?       @db.ObjectId
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  userId         String        @db.ObjectId
  user           User          @relation(fields: [userId], references: [id])
  amount         Float
  paymentMethod  PaymentMethod @default(UPI)
  transactionRef String?       @unique
  status         PaymentStatus @default(PENDING)
  gatewayPayload String?
  createdAt      DateTime      @default(now())

  refunds Refund[]
}

model Refund {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  paymentId         String   @db.ObjectId
  payment           Payment  @relation(fields: [paymentId], references: [id])
  amount            Float
  reason            String
  status            String   @default("PROCESSED")
  processedByUserId String?
  createdAt         DateTime @default(now())
}

model LoyaltyAccount {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  userId         String         @unique @db.ObjectId
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance  Int            @default(0)
  tier           MembershipTier @default(BRONZE)
  lifetimePoints Int            @default(0)
  stampsCount    Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  loyaltyAccountId String         @db.ObjectId
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  type             LoyaltyTxType
  points           Int
  description      String
  referenceId      String?
  createdAt        DateTime       @default(now())
}

model Reward {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  description    String
  pointsCost     Int
  discountAmount Float
  rewardType     RewardType @default(DISCOUNT_FLAT)
  minSpend       Float      @default(0.0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  rewardId  String   @db.ObjectId
  reward    Reward   @relation(fields: [rewardId], references: [id])
  code      String   @unique
  status    String   @default("ACTIVE")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Achievement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  code        String   @unique
  title       String
  description String
  badgeIcon   String
  pointsBonus Int      @default(50)
  createdAt   DateTime @default(now())

  unlockedBy CustomerAchievement[]
}

model CustomerAchievement {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  userId        String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String      @db.ObjectId
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Challenge {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  targetCount  Int      @default(5)
  rewardPoints Int      @default(100)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)

  customerChallenges CustomerChallenge[]
}

model CustomerChallenge {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId     String    @db.ObjectId
  challenge       Challenge @relation(fields: [challengeId], references: [id])
  currentProgress Int       @default(0)
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?

  @@unique([userId, challengeId])
}

model Coupon {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  code           String       @unique
  description    String
  discountType   DiscountType @default(PERCENT)
  discountValue  Float
  minOrderAmount Float        @default(0.0)
  maxDiscount    Float?
  expiresAt      DateTime
  isActive       Boolean      @default(true)

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  couponId        String   @db.ObjectId
  coupon          Coupon   @relation(fields: [couponId], references: [id])
  userId          String   @db.ObjectId
  user            User     @relation(fields: [userId], references: [id])
  orderId         String   @db.ObjectId
  order           Order    @relation(fields: [orderId], references: [id])
  discountApplied Float
  createdAt       DateTime @default(now())
}

model Feedback {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?  @db.ObjectId
  order     Order?   @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  actorUserId String   @db.ObjectId
  actor       User     @relation(fields: [actorUserId], references: [id])
  action      String
  entityName  String
  entityId    String?
  detailsJson String?
  createdAt   DateTime @default(now())
}

model Expense {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  category      String    // Raw Materials, Ingredients, Staff & Labour, Utilities, Rent & Maintenance, Equipment, Marketing, Other Expenses
  itemDetails   String
  amount        Float
  expenseDate   DateTime  @default(now())
  paymentMethod String    @default("Cash") // Cash, UPI, Card, Bank Transfer, Other
  note          String?
  createdBy     String    @db.ObjectId
  user          User      @relation(fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt

  @@index([expenseDate])
  @@index([category])
  @@index([createdBy])
}

model DailySales {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  staffId    String   @db.ObjectId
  staff      User     @relation(fields: [staffId], references: [id])
  salesDate  DateTime
  totalSales Float
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([staffId, salesDate])
  @@index([salesDate])
}
