generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  OWNER
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  PRE_ORDER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  CASH_AT_COUNTER
  LOYALTY_POINTS
}

enum MembershipTier {
  BRONZE
  SILVER
  GOLD
  VIP
}

enum LoyaltyTxType {
  EARN
  REDEEM
  EXPIRE
  REFUND_REVERSAL
  MANUAL_ADJUSTMENT
}

enum RewardType {
  FREE_ITEM
  DISCOUNT_PERCENT
  DISCOUNT_FLAT
}

enum DiscountType {
  PERCENT
  FLAT
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?   @unique
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile             CustomerProfile?
  bookings            Booking[]
  orders              Order[]
  payments            Payment[]
  loyaltyAccount      LoyaltyAccount?
  rewardRedemptions   RewardRedemption[]
  customerAchievements CustomerAchievement[]
  customerChallenges  CustomerChallenge[]
  couponRedemptions   CouponRedemption[]
  feedbacks           Feedback[]
  auditLogs           AuditLog[]
}

model CustomerProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthday     DateTime?
  preferences  String?
  favoriteItem String?
  totalOrders  Int      @default(0)
  totalSpend   Float    @default(0.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  products    Product[]
}

model Product {
  id              String   @id @default(uuid())
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  name            String
  description     String
  price           Float
  imageUrl        String?
  isAvailable     Boolean  @default(true)
  stockCount      Int      @default(100)
  isVeg           Boolean  @default(true)
  prepTimeMinutes Int      @default(10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customizations ProductCustomization[]
  orderItems     OrderItem[]
  comboItems     ComboItem[]
}

model ProductCustomization {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  optionsJson   String
  isMultiSelect Boolean  @default(false)
  isRequired    Boolean  @default(false)
}

model Combo {
  id            String   @id @default(uuid())
  name          String
  description   String
  originalPrice Float
  comboPrice    Float
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  items ComboItem[]
}

model ComboItem {
  id        String  @id @default(uuid())
  comboId   String
  combo     Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
}

model CafeTable {
  id          String      @id @default(uuid())
  tableNumber Int         @unique
  capacity    Int         @default(4)
  zone        String      @default("MAIN_HALL")
  status      TableStatus @default(AVAILABLE)
  qrCode      String?
  createdAt   DateTime    @default(now())

  bookings     Booking[]
  bookingHolds BookingHold[]
  orders       Order[]
}

model Booking {
  id           String        @id @default(uuid())
  bookingCode  String        @unique
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  tableId      String
  table        CafeTable     @relation(fields: [tableId], references: [id])
  guestCount   Int
  bookingDate  DateTime
  startTime    String
  endTime      String
  status       BookingStatus @default(PENDING)
  bookingFee   Float         @default(0.0)
  depositAmount Float        @default(0.0)
  qrCode       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  orders   Order[]
  payments Payment[]
}

model BookingHold {
  id          String    @id @default(uuid())
  tableId     String
  table       CafeTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  userId      String
  bookingDate DateTime
  startTime   String
  endTime     String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  tableId       String?
  table         CafeTable?    @relation(fields: [tableId], references: [id])
  bookingId     String?
  booking       Booking?      @relation(fields: [bookingId], references: [id])
  orderType     OrderType     @default(DINE_IN)
  status        OrderStatus   @default(PENDING)
  subtotal      Float
  discount      Float         @default(0.0)
  tax           Float         @default(0.0)
  totalAmount   Float
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items             OrderItem[]
  payments          Payment[]
  couponRedemptions CouponRedemption[]
  feedbacks         Feedback[]
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  productName        String
  unitPrice          Float
  quantity           Int
  subtotal           Float
  customizationsJson String?
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id])
  bookingId      String?
  booking        Booking?      @relation(fields: [bookingId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         Float
  paymentMethod  PaymentMethod @default(UPI)
  transactionRef String?       @unique
  status         PaymentStatus @default(PENDING)
  gatewayPayload String?
  createdAt      DateTime      @default(now())

  refunds Refund[]
}

model Refund {
  id                String   @id @default(uuid())
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id])
  amount            Float
  reason            String
  status            String   @default("PROCESSED")
  processedByUserId String?
  createdAt         DateTime @default(now())
}

model LoyaltyAccount {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance  Int            @default(0)
  tier           MembershipTier @default(BRONZE)
  lifetimePoints Int            @default(0)
  stampsCount    Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               String        @id @default(uuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  type             LoyaltyTxType
  points           Int
  description      String
  referenceId      String?
  createdAt        DateTime      @default(now())
}

model Reward {
  id             String     @id @default(uuid())
  title          String
  description    String
  pointsCost     Int
  discountAmount Float
  rewardType     RewardType @default(DISCOUNT_FLAT)
  minSpend       Float      @default(0.0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rewardId  String
  reward    Reward   @relation(fields: [rewardId], references: [id])
  code      String   @unique
  status    String   @default("ACTIVE")
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String
  badgeIcon   String
  pointsBonus Int      @default(50)
  createdAt   DateTime @default(now())

  unlockedBy CustomerAchievement[]
}

model CustomerAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Challenge {
  id           String   @id @default(uuid())
  title        String
  description  String
  targetCount  Int      @default(5)
  rewardPoints Int      @default(100)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)

  customerChallenges CustomerChallenge[]
}

model CustomerChallenge {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId     String
  challenge       Challenge @relation(fields: [challengeId], references: [id])
  currentProgress Int       @default(0)
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?

  @@unique([userId, challengeId])
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  description    String
  discountType   DiscountType @default(PERCENT)
  discountValue  Float
  minOrderAmount Float        @default(0.0)
  maxDiscount    Float?
  expiresAt      DateTime
  isActive       Boolean      @default(true)

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id              String   @id @default(uuid())
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  discountApplied Float
  createdAt       DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id])
  action      String
  entityName  String
  entityId    String?
  detailsJson String?
  createdAt   DateTime @default(now())
}
